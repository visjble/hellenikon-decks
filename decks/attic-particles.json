  "id": "attic-particles",
  "title": "Attic Particles and Connectives",
  "description": "Fifteen of the small words that hold Attic prose together: connectives, postpositive particles, the two negatives, and two common phrases.",
  "language": "grc",
  "dialect": "Attic",
  "level": "beginner",
